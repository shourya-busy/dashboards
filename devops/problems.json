                  "id": "color",
                  "value": {
                    "fixedColor": "#97AAB3",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 6,
          "w": 15,
          "x": 9,
          "y": 0
        },
        "id": 2,
        "options": {
          "colorMode": "background_solid",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "vertical",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showPercentChange": false,
          "text": {
            "titleSize": 18,
            "valueSize": 34
          },
          "textMode": "value_and_name",
          "wideLayout": true
        },
        "targets": [
          {
            "columns": [
              {
                "selector": "Disaster",
                "text": "Disaster",
                "type": "number"
              },
              {
                "selector": "High",
                "text": "High",
                "type": "number"
              },
              {
                "selector": "Average",
                "text": "Average",
                "type": "number"
              },
              {
                "selector": "Warning",
                "text": "Warning",
                "type": "number"
              },
              {
                "selector": "Information",
                "text": "Information",
                "type": "number"
              },
              {
                "selector": "Not classified",
                "text": "Not classified",
                "type": "number"
              }
            ],
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "grafana-alerts-api"
            },
            "filters": [],
            "format": "table",
            "parser": "backend",
            "refId": "A",
            "root_selector": "(\n  $sevOf := function($l){(\n    $raw := $l.SEVERITY ? $l.SEVERITY : ($l.severity ? $l.severity : \"\");\n    $s := $lowercase($trim($raw));\n    $contains($s, \"{{\") ? \"Not classified\" :\n    $s in [\"disaster\"] ? \"Disaster\" :\n    $s in [\"high\",\"critical\",\"crit\"] ? \"High\" :\n    $s in [\"average\",\"major\"] ? \"Average\" :\n    $s in [\"warning\",\"warn\",\"minor\"] ? \"Warning\" :\n    $s in [\"information\",\"info\"] ? \"Information\" : \"Not classified\"\n  )};\n  $s := $map($, function($a){ $sevOf($a.labels) });\n  [{\n    \"Disaster\": $count($s[$ = \"Disaster\"]),\n    \"High\": $count($s[$ = \"High\"]),\n    \"Average\": $count($s[$ = \"Average\"]),\n    \"Warning\": $count($s[$ = \"Warning\"]),\n    \"Information\": $count($s[$ = \"Information\"]),\n    \"Not classified\": $count($s[$ = \"Not classified\"])\n  }]\n)\n",
            "source": "url",
            "type": "json",
            "url": "http://localhost:3000/api/alertmanager/grafana/api/v2/alerts",
            "url_options": {
              "data": "",
              "method": "GET",
              "params": [
                {
                  "key": "active",
                  "value": "true"
                },
                {
                  "key": "silenced",
                  "value": "${suppressed}"
                },
                {
                  "key": "inhibited",
                  "value": "${suppressed}"
                }
              ]
            }
          }
        ],
        "title": "Problems by severity",
        "transformations": [
          {
            "id": "organize",
            "options": {
              "indexByName": {
                "Average": 2,
                "Disaster": 0,
                "High": 1,
                "Information": 4,
                "Not classified": 5,
                "Warning": 3
              }
            }
          }
        ],
        "type": "stat"
      },
      {
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "grafana-alerts-api"
        },
        "description": "Firing Grafana alert instances (Grafana Alertmanager). Actions = contact point(s) it was routed to. DatasourceNoData/Error rows show the originating rule.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "left",
              "cellOptions": {
                "type": "auto"
              },
              "filterable": true,
              "inspect": false,
              "wrapText": false
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text"
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "severity"
              },
              "properties": [
                {
                  "id": "custom.hidden",
                  "value": true
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "rank"
              },
              "properties": [
                {
                  "id": "custom.hidden",
                  "value": true
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "duration_s"
              },
