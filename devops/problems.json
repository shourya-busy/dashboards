{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "zbx-problems"
  },
  "spec": {
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "Zabbix-style problems view over Grafana-managed alerts",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "links": [
      {
        "icon": "bell",
        "title": "Alert rules",
        "type": "link",
        "url": "/alerting/list"
      },
      {
        "icon": "bell-slash",
        "title": "Silences",
        "type": "link",
        "url": "/alerting/silences"
      }
    ],
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "dfkg2or6vso3kf"
        },
        "description": "A host = distinct `host` label on Prometheus `up`. Available: at least one target up. Not available: all targets down. Unknown: seen in the last 24h but no longer scraped.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "fixedColor": "#97AAB3",
              "mode": "fixed"
            },
            "decimals": 0,
            "links": [],
            "unit": "none"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Available"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#59DB8F",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Not available"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#E45959",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Unknown"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#97AAB3",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Total"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "transparent",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 6,
          "w": 9,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "background_solid",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "vertical",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showPercentChange": false,
          "text": {
            "titleSize": 18,
            "valueSize": 34
          },
          "textMode": "value_and_name",
          "wideLayout": true
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "dfkg2or6vso3kf"
            },
            "expr": "count(max by (host) (up) == 1) or vector(0)",
            "instant": true,
            "legendFormat": "Available",
            "range": false,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "dfkg2or6vso3kf"
            },
            "expr": "count(max by (host) (up) == 0) or vector(0)",
            "instant": true,
            "legendFormat": "Not available",
            "range": false,
            "refId": "B"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "dfkg2or6vso3kf"
            },
            "expr": "count(max by (host) (max_over_time(up[1d])) unless on (host) max by (host) (up)) or vector(0)",
            "instant": true,
            "legendFormat": "Unknown",
            "range": false,
            "refId": "C"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "dfkg2or6vso3kf"
            },
            "expr": "count(max by (host) (max_over_time(up[1d]))) or vector(0)",
            "instant": true,
            "legendFormat": "Total",
            "range": false,
            "refId": "D"
          }
        ],
        "title": "Host availability",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "grafana-alerts-api"
        },
        "description": "Active Grafana alert instances grouped by SEVERITY label. CRITICAL counts as High; a missing or unrendered SEVERITY label counts as Not classified. Click a tile to filter Current problems.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "fixedColor": "#97AAB3",
              "mode": "fixed"
            },
            "decimals": 0,
            "links": [
