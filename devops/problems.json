              },
              "properties": [
                {
                  "id": "unit",
                  "value": "time: YYYY-MM-DD HH:mm:ss"
                },
                {
                  "id": "custom.width",
                  "value": 175
                },
                {
                  "id": "custom.align",
                  "value": "right"
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#4F8EDB",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "Alert rule",
                      "url": "${__data.fields.rule_url}"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Info"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 55
                },
                {
                  "id": "custom.align",
                  "value": "center"
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "⛔": {
                          "index": 1,
                          "text": "⛔"
                        },
                        "🔕": {
                          "index": 0,
                          "text": "🔕"
                        }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Host"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 150
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Problem • Severity"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "applyToRow": false,
                    "mode": "basic",
                    "type": "color-background",
                    "wrapText": true
                  }
                },
                {
                  "id": "custom.wrapText",
                  "value": true
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "pattern": "^Disaster\\|(.*)$",
                        "result": {
                          "color": "#E45959",
                          "index": 0,
                          "text": "$1"
                        }
                      },
                      "type": "regex"
                    },
                    {
                      "options": {
                        "pattern": "^High\\|(.*)$",
                        "result": {
                          "color": "#E97659",
                          "index": 1,
                          "text": "$1"
                        }
                      },
                      "type": "regex"
                    },
                    {
                      "options": {
                        "pattern": "^Average\\|(.*)$",
                        "result": {
                          "color": "#FFA059",
                          "index": 2,
                          "text": "$1"
                        }
                      },
                      "type": "regex"
                    },
                    {
                      "options": {
                        "pattern": "^Warning\\|(.*)$",
                        "result": {
                          "color": "#FFC859",
                          "index": 3,
                          "text": "$1"
                        }
                      },
                      "type": "regex"
                    },
                    {
                      "options": {
                        "pattern": "^Information\\|(.*)$",
                        "result": {
                          "color": "#7499FF",
                          "index": 4,
                          "text": "$1"
                        }
                      },
                      "type": "regex"
                    },
                    {
                      "options": {
                        "pattern": "^Not\\sclassified\\|(.*)$",
                        "result": {
                          "color": "#97AAB3",
                          "index": 5,
                          "text": "$1"
                        }
                      },
                      "type": "regex"
                    }
                  ]
                },
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "Open alert rule",
                      "url": "${__data.fields.rule_url}"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Duration"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 130
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Actions"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 120
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "empty": {
                          "color": "#E45959",
                          "index": 0,
                          "text": "✖ no receiver"
                        }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Tags"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "color": "#768690",
                    "colorMode": "fixed",
                    "type": "pill"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#768690",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.wrapText",
                  "value": true
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 20,
          "w": 24,
          "x": 0,
          "y": 6
        },
        "id": 3,
        "options": {
          "cellHeight": "md",
          "footer": {
            "show": false
          },
          "frozenColumns": {},
          "showHeader": true,
          "sortBy": [
            {
              "desc": true,
              "displayName": "Time"
            }
          ]
        },
        "targets": [
          {
            "columns": [
              {
                "selector": "time",
                "text": "Time",
                "type": "timestamp"
              },
              {
                "selector": "info",
                "text": "Info",
                "type": "string"
              },
              {
                "selector": "host",
                "text": "Host",
                "type": "string"
              },
              {
                "selector": "problem",
                "text": "Problem • Severity",
                "type": "string"
              },
              {
                "selector": "duration",
                "text": "Duration",
                "type": "string"
              },
              {
                "selector": "actions",
                "text": "Actions",
                "type": "string"
              },
              {
                "selector": "tags",
                "text": "Tags",
                "type": "string"
              },
              {
                "selector": "severity",
                "text": "severity",
                "type": "string"
              },
              {
                "selector": "rank",
                "text": "rank",
                "type": "number"
              },
              {
                "selector": "duration_s",
                "text": "duration_s",
                "type": "number"
              },
              {
                "selector": "folder",
                "text": "folder",
                "type": "string"
              },
              {
                "selector": "rule_url",
                "text": "rule_url",
                "type": "string"
              },
              {
                "selector": "fingerprint",
                "text": "fingerprint",
                "type": "string"
              }
            ],
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "grafana-alerts-api"
            },
            "filters": [],
            "format": "table",
            "parser": "backend",
            "refId": "A",
            "root_selector": "(\n  $sevOf := function($l){(\n    $raw := $l.SEVERITY ? $l.SEVERITY : ($l.severity ? $l.severity : \"\");\n    $s := $lowercase($trim($raw));\n    $contains($s, \"{{\") ? \"Not classified\" :\n    $s in [\"disaster\"] ? \"Disaster\" :\n    $s in [\"high\",\"critical\",\"crit\"] ? \"High\" :\n    $s in [\"average\",\"major\"] ? \"Average\" :\n    $s in [\"warning\",\"warn\",\"minor\"] ? \"Warning\" :\n    $s in [\"information\",\"info\"] ? \"Information\" : \"Not classified\"\n  )};\n  $rank := {\"Disaster\":5,\"High\":4,\"Average\":3,\"Warning\":2,\"Information\":1,\"Not classified\":0};\n  $dur := function($t){(\n    $d := $floor($t / 86400); $h := $floor(($t % 86400) / 3600);\n    $m := $floor(($t % 3600) / 60); $x := $floor($t % 60);\n    $d >= 30 ? ($string($floor($d / 30)) & \"M \" & $string($d % 30) & \"d \" & $string($h) & \"h\") :\n    $d > 0 ? ($string($d) & \"d \" & $string($h) & \"h \" & $string($m) & \"m\") :\n    $h > 0 ? ($string($h) & \"h \" & $string($m) & \"m \" & $string($x) & \"s\") :\n    $m > 0 ? ($string($m) & \"m \" & $string($x) & \"s\") : ($string($x) & \"s\")\n  )};\n  $skip := [\"alertname\",\"rulename\",\"datasource_uid\",\"ref_id\",\"SEVERITY\",\"severity\",\"host\",\"instance\",\"grafana_folder\"];\n  $now := $millis();\n  $rows := $map($, function($a){(\n    $l := $a.labels;\n    $sev := $sevOf($l);\n    $hst := $l.host ? $l.host : ($l.instance ? $l.instance : ($l.grafana_folder ? \"(\" & $l.grafana_folder & \")\" : \"\"));\n    $isDs := $l.alertname in [\"DatasourceNoData\",\"DatasourceError\"];\n    $title := $isDs ? (($l.alertname = \"DatasourceNoData\" ? \"No data: \" : \"Query error: \") & ($l.rulename ? $l.rulename : $l.alertname))\n              : ($a.annotations.summary ? $a.annotations.summary : $l.alertname);\n    $tagKeys := $sort($keys($l)[$not($substring($, 0, 2) = \"__\") and $not($ in $skip)]);\n    $st := $a.status.state;\n    {\n      \"time\": $a.startsAt,\n      \"info\": $st = \"suppressed\" ? ($count($a.status.silencedBy) > 0 ? \"🔕\" : \"⛔\") : \"\",\n      \"host\": $hst,\n      \"problem\": $sev & \"|\" & $title,\n      \"severity\": $sev,\n      \"rank\": $lookup($rank, $sev),\n      \"duration\": $dur(($now - $toMillis($a.startsAt)) / 1000),\n      \"duration_s\": $floor(($now - $toMillis($a.startsAt)) / 1000),\n      \"actions\": $join($a.receivers.name, \", \"),\n      \"tags\": $join($map($tagKeys, function($k){ $k & \": \" & $lookup($l, $k) }), \",\"),\n      \"folder\": $l.grafana_folder,\n      \"rule_url\": \"/alerting/grafana/\" & $l.__alert_rule_uid__ & \"/view\",\n      \"fingerprint\": $a.fingerprint\n    }\n  )});\n  $sevs := [${severity:doublequote}];\n  $hq := $lowercase($trim(\"${host}\"));\n  [$rows[$.severity in $sevs and ($hq = \"\" or $contains($lowercase($.host), $hq) or $contains($lowercase($.tags), $hq))]]\n)\n",
            "source": "url",
            "type": "json",
            "url": "http://localhost:3000/api/alertmanager/grafana/api/v2/alerts",
            "url_options": {
